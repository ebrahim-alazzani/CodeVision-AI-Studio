<Page
    x:Class="CodeVision.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">

    <Grid Padding="20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Settings Inputs -->
        <Border Background="{ThemeResource CyberCardGlassBrush}" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Text="⚙ إعدادات البيئة والمحرك" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource CyberPrimaryBrush}"/>

                    <StackPanel Spacing="6">
                        <TextBox x:Name="PythonPathBox" Header="مسار مفسر بايثون (Python Executable)"/>
                        <Button Content="🔍 اكتشاف بايثون Anaconda تلقائياً" CornerRadius="6" Click="AutoDetectAnaconda_Click"/>
                    </StackPanel>

                    <TextBox x:Name="FfmpegPathBox" Header="مسار أداة FFmpeg"/>
                    <TextBox x:Name="OutputDirBox" Header="مجلد إخراج المشاريع والنتائج"/>
                    <TextBox x:Name="DatasetsDirBox" Header="مجلد مجموعات البيانات"/>
                    <TextBox x:Name="ModelsDirBox" Header="مجلد أوزان النماذج"/>

                    <ComboBox x:Name="ThemeCombo" Header="المظهر (Theme)" HorizontalAlignment="Stretch"/>

                    <Button x:Name="SaveSettingsBtn" Content="💾 حفظ الإعدادات" Background="{ThemeResource CyberProgressBarBrush}" Foreground="White" CornerRadius="8" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="SaveSettingsBtn_Click"/>

                    <TextBlock x:Name="SaveNoticeLabel" Text="" Foreground="{ThemeResource CyberSuccessBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right System Diagnostic Log -->
        <Border Grid.Column="1" Background="{ThemeResource CyberCardGlassBrush}" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📋 سجل النظام والتشخيص المباشر" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource CyberSecondaryBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="🔄 تحديث السجل" CornerRadius="6" Click="RefreshLogsBtn_Click"/>
                </Grid>

                <Border Grid.Row="1" Background="#0A0F1D" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#1E293B">
                    <TextBox x:Name="LogsTextBox" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Code" FontSize="12" IsReadOnly="True" Background="Transparent" Foreground="#38BDF8" BorderThickness="0"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
