<Page
    x:Class="CodeVision.Desktop.Views.ExtractionReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <!-- 0. Top Control Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Live Algorithm & Telemetry HUD Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Studio Workspace (Video & Vision on Left vs Modular Panels on Right) -->
            <RowDefinition Height="*"/>
            <!-- 3. Bottom Detected Scenes Strip -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Top Control Toolbar -->
        <Border Grid.Row="0"
                Background="{ThemeResource HalvoCardGlassBrush}"
                Padding="16,10"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{ThemeResource HalvoCardBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Time & Frame Counter -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#265FD8C4" Padding="8,4" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource HalvoCyanBrush}">
                        <TextBlock x:Name="TimeLabel" Text="00:00 / 02:00" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource HalvoCyanBrush}"/>
                    </Border>
                    <TextBlock x:Name="FrameCounterLabel" Text="Frame: 1 / 3600" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Timeline Slider -->
                <Slider x:Name="TimelineSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="120"
                        Value="0"
                        Margin="0,0,14,0"
                        ValueChanged="TimelineSlider_ValueChanged"/>

                <!-- Simulation Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Button x:Name="PlaySimBtn"
                            Click="PlaySimBtn_Click"
                            Background="{ThemeResource HalvoGradientCyanBlue}"
                            Foreground="#0B0F15"
                            CornerRadius="8"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="12"/>
                            <TextBlock Text="▶ تشغيل المحاكاة" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PauseSimBtn"
                            Click="PauseSimBtn_Click"
                            CornerRadius="8"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE769;" FontSize="12" Foreground="{ThemeResource HalvoAmberBrush}"/>
                            <TextBlock Text="⏸ إيقاف" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NextFrameBtn"
                            Click="NextFrameBtn_Click"
                            CornerRadius="8"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource HalvoBlueBrush}"/>
                            <TextBlock Text="⏭ إطار تالٍ" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Playback Speed Selector (Slow-motion for OpenCV algorithm inspection) -->
                <ComboBox x:Name="PlaybackSpeedCombo"
                          Grid.Column="3"
                          SelectedIndex="1"
                          SelectionChanged="PlaybackSpeedCombo_SelectionChanged"
                          Width="165"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="0.5x (بطيء لرصد OpenCV)"/>
                    <ComboBoxItem Content="1.0x (سرعة طبيعية)"/>
                    <ComboBoxItem Content="2.0x (سريع Turbo)"/>
                </ComboBox>

                <!-- Open Real Video Button -->
                <Button Grid.Column="4"
                        Click="LoadRealVideoBtn_Click"
                        CornerRadius="8"
                        Padding="10,6"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="فتح ملف فيديو حقيقي من جهازك وتشغيله داخل الاستوديو">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED25;" FontSize="12" Foreground="{ThemeResource HalvoCyanBrush}"/>
                        <TextBlock Text="📂 فتح فيديو" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 1. Live Algorithm & Telemetry HUD Bar (شريط تتبع الخوارزميات والمكتبات اللحظي) -->
        <Border Grid.Row="1"
                Background="{ThemeResource HalvoHeaderGlassBrush}"
                Padding="12,8"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource HalvoCardBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Action Status -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource HalvoCyanBrush}"/>
                    <TextBlock x:Name="ActionStatusLabel" Text="🟢 [CAPTURED] مشهد شيفرة جديد - تم عزل محرر الكود وتطبيق OCR" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource HalvoCyanBrush}"/>
                </StackPanel>

                <!-- Algorithm -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="الخوارزمية:" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>
                    <TextBlock x:Name="AlgorithmLabel" Text="cv2.compareHist + SSIM" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource HalvoBlueBrush}"/>
                </StackPanel>

                <!-- Library -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="المكتبة:" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>
                    <TextBlock x:Name="LibraryLabel" Text="OpenCV 4.10 · Tesseract · Whisper" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource HalvoPurpleBrush}"/>
                </StackPanel>

                <!-- ROI Box -->
                <Border Grid.Column="3" Background="#1A77D6A0" Padding="8,3" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource HalvoEmeraldBrush}">
                    <TextBlock x:Name="RoiLabel" Text="ROI: [X:30, Y:25, W:420, H:260]" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource HalvoEmeraldBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Main Studio Workspace (Real Video & OpenCV on Left vs Multi-Pane Studio on Right) -->
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <!-- Real Video Player & OpenCV Simulation View -->
                <ColumnDefinition Width="1.3*"/>
                <!-- Modular Studio Panels on Right -->
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Real Video Viewport & OpenCV Tracking Canvas -->
            <Border Grid.Column="0"
                    Background="{ThemeResource HalvoCardGlassBrush}"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource HalvoCardBorderBrush}"
                    Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <!-- Video Viewport Canvas -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Audio & Transcript Live Banner -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Real Video Player Container with OpenCV Bounding Box Overlay -->
                    <Border Grid.Row="0" Background="#05080E" CornerRadius="10" BorderThickness="1" BorderBrush="#1E293B">
                        <Grid x:Name="ViewportGrid">
                            <!-- Real Video Player Element -->
                            <MediaPlayerElement x:Name="RealVideoPlayer"
                                                AutoPlay="False"
                                                AreTransportControlsEnabled="True"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Visibility="Collapsed"/>

                            <!-- Captured Keyframe Screenshot Image with OpenCV Tracking -->
                            <Image x:Name="KeyframeSnapshotImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Visibility="Collapsed"/>

                            <!-- Placeholder when no video is loaded -->
                            <StackPanel x:Name="NoVideoPlaceholder"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="10"
                                        Visibility="Visible">
                                <FontIcon Glyph="&#xE714;" FontSize="40" Foreground="{ThemeResource HalvoCyanBrush}"/>
                                <TextBlock Text="CodeVision Live Vision Feed" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource HalvoCyanBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="اختر فيديو حقيقي لتشغيله ومتابعة رصد OpenCV لمنطقة الكود وتتبع الإطارات اللحظي." FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <Button Click="LoadRealVideoBtn_Click" HorizontalAlignment="Center" Background="{ThemeResource HalvoGradientCyanBlue}" Foreground="#0B0F15" CornerRadius="8" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" Foreground="#0B0F15"/>
                                        <TextBlock Text="📂 فتح ملف فيديو حقيقي للمحاكاة" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- OpenCV Real-time Active Bounding Box Overlay Canvas -->
                            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                                <!-- Main Code Editor Bounding Box -->
                                <Border x:Name="BoundingBoxOverlay"
                                        BorderBrush="{ThemeResource HalvoCyanBrush}"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Background="#0F5FD8C4"
                                        Width="380"
                                        Height="230"
                                        Canvas.Left="25"
                                        Canvas.Top="20">
                                    <Grid VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6">
                                        <Border Background="#E60B0F15" Padding="6,3" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource HalvoCyanBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="🎯 OpenCV ROI:" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource HalvoCyanBrush}"/>
                                                <TextBlock x:Name="RoiScoreBadge" Text="96.5% دقة" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource HalvoEmeraldBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Text Lines Bounding Boxes -->
                                <Border x:Name="CodeLine1" BorderBrush="{ThemeResource HalvoBlueBrush}" BorderThickness="1" Background="#0D38BDF8" Width="260" Height="18" Canvas.Left="45" Canvas.Top="60" CornerRadius="3"/>
                                <Border x:Name="CodeLine2" BorderBrush="{ThemeResource HalvoBlueBrush}" BorderThickness="1" Background="#0D38BDF8" Width="300" Height="18" Canvas.Left="45" Canvas.Top="85" CornerRadius="3"/>
                                <Border x:Name="CodeLine3" BorderBrush="{ThemeResource HalvoBlueBrush}" BorderThickness="1" Background="#0D38BDF8" Width="220" Height="18" Canvas.Left="45" Canvas.Top="110" CornerRadius="3"/>

                                <!-- Webcam / Lecturer Area Skipped -->
                                <Border x:Name="WebcamSkippedBox" Width="95" Height="65" Canvas.Left="430" Canvas.Top="170" Background="#990B0F15" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource HalvoRoseBrush}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                        <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource HalvoRoseBrush}"/>
                                        <TextBlock Text="تجاهل الكاميرا" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource HalvoRoseBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Bottom Live Status & Audio Banner -->
                    <Border Grid.Row="1" Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" Background="#2638BDF8" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource HalvoBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="التفريغ الصوتي المتزامن (Faster-Whisper):" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource HalvoBlueBrush}"/>
                                <TextBlock x:Name="SpeechTranscriptLabel" Text="في هذا الجزء نبدأ بإنشاء هيكل المشروع المكتوب بلغة C# وتجهيز نقطة الدخول Main." FontSize="11" Foreground="{ThemeResource HalvoTextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Multi-Tab Studio Workspace (Live Log, Code, Transcript, Audio) -->
            <Border Grid.Column="1"
                    Background="{ThemeResource HalvoCardGlassBrush}"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource HalvoCardBorderBrush}"
                    Padding="14">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <!-- Tab Selector Buttons -->
                        <RowDefinition Height="Auto"/>
                        <!-- Active Tab Content Area -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Studio Tabs Header -->
                    <Border Grid.Row="0" Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="4" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tab 1: Live Logs -->
                            <Button x:Name="TabBtnLogs"
                                    Grid.Column="0"
                                    Click="TabBtnLogs_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="{ThemeResource HalvoGradientCyanBlue}"
                                    Foreground="#0B0F15"
                                    CornerRadius="7"
                                    Padding="6,6">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="11"/>
                                    <TextBlock Text="📜 السجل الحي" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Tab 2: Code -->
                            <Button x:Name="TabBtnCode"
                                    Grid.Column="1"
                                    Click="TabBtnCode_Click"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="7"
                                    Padding="6,6">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE943;" FontSize="11" Foreground="{ThemeResource HalvoCyanBrush}"/>
                                    <TextBlock Text="💻 الشيفرة" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Tab 3: Transcript -->
                            <Button x:Name="TabBtnTranscript"
                                    Grid.Column="2"
                                    Click="TabBtnTranscript_Click"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="7"
                                    Padding="6,6">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="11" Foreground="{ThemeResource HalvoBlueBrush}"/>
                                    <TextBlock Text="💬 النص والصوت" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Tab 4: Audio Info -->
                            <Button x:Name="TabBtnAudio"
                                    Grid.Column="3"
                                    Click="TabBtnAudio_Click"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="7"
                                    Padding="6,6">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D8;" FontSize="11" Foreground="{ThemeResource HalvoPurpleBrush}"/>
                                    <TextBlock Text="🔊 مسار الصوت" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- TAB 1 CONTENT: Live Execution Log & Console -->
                    <Grid x:Name="PaneLiveLogs" Grid.Row="1" Visibility="Visible" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="سجل عمليات ومخرجات المعالجة اللحظية (Live Event Feed):" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="ClearLogsBtn_Click" Padding="8,3" CornerRadius="6" FontSize="10">
                                <TextBlock Text="مسح السجل" FontSize="10"/>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="#06090E" CornerRadius="10" Padding="8" BorderThickness="1" BorderBrush="#1E293B">
                            <ListView x:Name="LiveLogsList" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas, Cascadia Code, Courier New"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource HalvoCyanBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                    <!-- TAB 2 CONTENT: Extracted Code & AST Preview -->
                    <Grid x:Name="PaneCode" Grid.Row="1" Visibility="Collapsed" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="#2677D6A0" Padding="6,2" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource HalvoEmeraldBrush}">
                                        <TextBlock x:Name="SnippetLangBadge" Text="C# (.NET 9)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource HalvoEmeraldBrush}"/>
                                    </Border>
                                    <TextBlock x:Name="SnippetFileLabel" Text="Program.cs" FontWeight="Black" FontSize="13" Foreground="{ThemeResource HalvoCyanBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="SnippetConfidenceLabel" Text="درجة الثقة: 95% · التوقيت: 00:00" FontSize="10" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Click="CopyCodeBtn_Click" CornerRadius="8" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                                    <TextBlock Text="نسخ الشيفرة" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Code Box -->
                        <Border Grid.Row="1" Background="#06090E" CornerRadius="10" Padding="10" BorderThickness="1" BorderBrush="#1E293B">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox x:Name="CodePreviewBox"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas, Cascadia Code, Fira Code"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         Foreground="#E2E8F0"
                                         BorderThickness="0"/>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Row="2" Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="8,5" CornerRadius="7" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                            <TextBlock x:Name="SnippetExplanationLabel" Text="نقطة البداية الأساسية للتطبيق وتهيئة المحرك." FontSize="10" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- TAB 3 CONTENT: Transcript Segments List -->
                    <Grid x:Name="PaneTranscript" Grid.Row="1" Visibility="Collapsed" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="مقاطع الشرح والتفريغ الصوتي (انقر للانتقال المباشر):" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>

                        <Border Grid.Row="1" Background="#06090E" CornerRadius="10" Padding="6" BorderThickness="1" BorderBrush="#1E293B">
                            <ListView x:Name="TranscriptsListView" SelectionChanged="TranscriptsListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" Padding="8,6" Background="{ThemeResource HalvoHeaderGlassBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#2638BDF8" Padding="6,2" CornerRadius="5" VerticalAlignment="Top" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TimeRangeFormatted}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource HalvoBlueBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11" Foreground="{ThemeResource HalvoTextPrimaryBrush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                    <!-- TAB 4 CONTENT: Audio Track & Status -->
                    <Grid x:Name="PaneAudio" Grid.Row="1" Visibility="Collapsed" RowSpacing="12">
                        <Border Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="14" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="34" Height="34" Background="#26A855F7" CornerRadius="8">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="{ThemeResource HalvoPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="مسار الصوت المستخرج (Extracted Audio WAV)" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource HalvoPurpleBrush}"/>
                                        <TextBlock x:Name="AudioStatusLabel" Text="16 kHz Mono PCM WAV جاهز للمحاكاة" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <MenuFlyoutSeparator/>

                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="التردد والصيغة:" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="16,000 Hz · 16-bit Mono PCM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource HalvoCyanBrush}"/>

                                    <TextBlock Grid.Row="1" Text="محرك الاستخراج:" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="FFmpeg v9.0.2 + ImageIO Bundle" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource HalvoBlueBrush}"/>

                                    <TextBlock Grid.Row="2" Text="محرك التفريغ:" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Faster-Whisper (OpenAI Architecture)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource HalvoEmeraldBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Scenes Strip (شريط المشاهد المكتشفة) -->
        <Border Grid.Row="3"
                Background="{ThemeResource HalvoCardGlassBrush}"
                Padding="12,8"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{ThemeResource HalvoCardBorderBrush}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="🎬 المشاهد البرمجية المكتشفة بواسطة OpenCV (انقر على أي مشهد للانتقال إليه ومحاكاته):" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>

                <ListView x:Name="ScenesList"
                          Grid.Row="1"
                          SelectionChanged="ScenesList_SelectionChanged">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="240"
                                    Margin="0,0,10,0"
                                    Padding="10,8"
                                    Background="{ThemeResource HalvoHeaderGlassBrush}"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimestampFormatted}" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource HalvoCyanBrush}"/>
                                        <Border Grid.Column="1" Background="#2677D6A0" Padding="6,2" CornerRadius="4">
                                            <TextBlock Text="{Binding ConfidencePercent}" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource HalvoEmeraldBrush}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{ThemeResource HalvoTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
