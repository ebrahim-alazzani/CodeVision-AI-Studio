<Page
    x:Class="CodeVision.Desktop.Views.TrainingLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">

    <Grid Padding="24" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <!-- Left Hyperparameters Panel -->
            <ColumnDefinition Width="380"/>
            <!-- Right Live Training Visual Chart & Metrics Panel -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Hyperparameters & Active Dataset Panel -->
        <Border Background="{ThemeResource HalvoCardGlassBrush}"
                Padding="18"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{ThemeResource HalvoCardBorderBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="🔬 مختبر تدريب النماذج (Training Lab)" FontWeight="Black" FontSize="14" Foreground="{ThemeResource HalvoRoseBrush}"/>
                        <TextBlock Text="تدريب ومعايرة نماذج الرؤية الحاسوبية على مجموعة الإطارات والملفات المستخرجة." Foreground="{ThemeResource HalvoTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Active Extracted Dataset Card -->
                    <Border Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="12" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource HalvoCyanBrush}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE81E;" FontSize="14" Foreground="{ThemeResource HalvoCyanBrush}"/>
                                <TextBlock Text="بيانات التدريب المستخرجة من الفيديوهات" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource HalvoCyanBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="DatasetSummaryLabel" Text="مجلد المخرجات: C:\Users\ibral\AppData\Local\CodeVision\output" FontSize="10" Foreground="{ThemeResource HalvoTextSecondaryBrush}" TextWrapping="Wrap"/>

                            <!-- Dataset Metrics Grid -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TotalJobsMetric" Text="15" FontWeight="Black" FontSize="16" Foreground="{ThemeResource HalvoCyanBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="دروس فيديو" FontSize="9" Foreground="{ThemeResource HalvoTextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TotalKeyframesMetric" Text="32" FontWeight="Black" FontSize="16" Foreground="{ThemeResource HalvoBlueBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="إطارات كود" FontSize="9" Foreground="{ThemeResource HalvoTextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TotalFilesMetric" Text="12" FontWeight="Black" FontSize="16" Foreground="{ThemeResource HalvoEmeraldBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ملفات مستعادة" FontSize="9" Foreground="{ThemeResource HalvoTextSecondaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- What the model trains on -->
                    <Border Background="#1A77D6A0" Padding="10" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource HalvoEmeraldBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="🎯 على ماذا يتدرب النموذج؟" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource HalvoEmeraldBrush}"/>
                            <TextBlock Text="• عزل نافذة محرر الكود وتجاهل وجوه المحاضرين وكاميرات الويب." FontSize="10" Foreground="{ThemeResource HalvoTextPrimaryBrush}"/>
                            <TextBlock Text="• تصنيف لغة الشيفرة (C# / Python / TypeScript) من الرموز." FontSize="10" Foreground="{ThemeResource HalvoTextPrimaryBrush}"/>
                            <TextBlock Text="• تحسين دقة OCR لقراءة الأقواس البرمجية { } و => والفاصلة المنقوطة." FontSize="10" Foreground="{ThemeResource HalvoTextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <MenuFlyoutSeparator Margin="0,2"/>

                    <TextBox x:Name="ModelNameBox" Header="اسم إصدار النموذج (Model Name)" Text="CodeVision-CNN-Classifier-v2"/>
                    <TextBox x:Name="DatasetPathBox" Header="مسار مجموعة البيانات المستخرجة (Dataset Path)" Text="C:\Users\ibral\AppData\Local\CodeVision\output"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EpochsBox" Header="عدد الحِقب (Epochs)" Text="25"/>
                        <TextBox x:Name="BatchSizeBox" Grid.Column="1" Header="حجم الدفعة (Batch)" Text="32"/>
                    </Grid>

                    <TextBox x:Name="LearningRateBox" Header="معدل التعلم (Learning Rate)" Text="0.001"/>

                    <!-- Train / Val / Test Split -->
                    <TextBlock Text="تقسيم البيانات (Train / Val / Test Split):" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource HalvoTextPrimaryBrush}" Margin="0,4,0,0"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Header="Train" Text="70%"/>
                        <TextBox Grid.Column="1" Header="Val" Text="15%"/>
                        <TextBox Grid.Column="2" Header="Test" Text="15%"/>
                    </Grid>

                    <ComboBox x:Name="OptimizerCombo" Header="خوارزمية التحسين (Optimizer)" HorizontalAlignment="Stretch"/>
                    <ComboBox x:Name="LossCombo" Header="دالة الخسارة (Loss Function)" HorizontalAlignment="Stretch"/>

                    <!-- Training Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                        <Button x:Name="StartTrainBtn"
                                Click="StartTrainBtn_Click"
                                Background="{ThemeResource HalvoGradientCyanBlue}"
                                Foreground="#0B0F15"
                                CornerRadius="8"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="#0B0F15"/>
                                <TextBlock Text="🚀 بدء التدريب على البيانات المستخرجة" FontWeight="Black"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelTrainBtn"
                                Click="CancelTrainBtn_Click"
                                CornerRadius="8"
                                Padding="14,8"
                                Foreground="{ThemeResource HalvoRoseBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{ThemeResource HalvoRoseBrush}"/>
                                <TextBlock Text="⏹ إيقاف" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Live Training Progress & Metrics Panel -->
        <Border Grid.Column="1"
                Background="{ThemeResource HalvoCardGlassBrush}"
                Padding="18"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{ThemeResource HalvoCardBorderBrush}">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Metrics Cards -->
                    <RowDefinition Height="Auto"/>
                    <!-- VISUAL CHART: Training Loss & Accuracy Curves -->
                    <RowDefinition Height="200"/>
                    <!-- Epoch History Logs -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📊 متابعة التدريب والتقييم الحي (Live Model Metrics)" FontWeight="Black" FontSize="14" Foreground="{ThemeResource HalvoTextPrimaryBrush}"/>
                    <Border Grid.Column="1" Background="#2677D6A0" Padding="8,4" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource HalvoEmeraldBrush}">
                        <TextBlock x:Name="StatusBadge" Text="حالة المختبر: في انتظار الإعداد" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource HalvoEmeraldBrush}"/>
                    </Border>
                </Grid>

                <!-- Metrics Cards -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="14" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="الحِقبة الحالية (Epoch)" Foreground="{ThemeResource HalvoTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="EpochMetricLabel" Text="0 / 25" FontSize="20" FontWeight="Black" Foreground="{ThemeResource HalvoCyanBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="14" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="خسارة التدريب (Loss)" Foreground="{ThemeResource HalvoTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LossMetricLabel" Text="0.0000" FontSize="20" FontWeight="Black" Foreground="{ThemeResource HalvoRoseBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="14" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="دقة النموذج (Accuracy)" Foreground="{ThemeResource HalvoTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AccuracyMetricLabel" Text="0.0%" FontSize="20" FontWeight="Black" Foreground="{ThemeResource HalvoEmeraldBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="14" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="دقة التحقق (Validation)" Foreground="{ThemeResource HalvoTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ValAccuracyMetricLabel" Text="0.0%" FontSize="20" FontWeight="Black" Foreground="{ThemeResource HalvoAmberBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- VISUAL CHART: Training Curves (مخطط تقارب النموذج ودقة التدريب) -->
                <Border Grid.Row="2" Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="14" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📈 مخطط تقارب التدريب والتحقق (Convergence Curves)" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource HalvoTextPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{ThemeResource HalvoRoseBrush}"/>
                                    <TextBlock Text="Loss Curve" FontSize="10" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{ThemeResource HalvoEmeraldBrush}"/>
                                    <TextBlock Text="Accuracy Curve" FontSize="10" Foreground="{ThemeResource HalvoTextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Simulated Visual Curve Display -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Milestone 1 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                <Border Height="35" Width="14" CornerRadius="6" Background="{ThemeResource HalvoEmeraldBrush}"/>
                                <TextBlock Text="Ep 5" FontSize="10" Foreground="{ThemeResource HalvoTextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Milestone 2 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                <Border Height="60" Width="14" CornerRadius="6" Background="{ThemeResource HalvoEmeraldBrush}"/>
                                <TextBlock Text="Ep 10" FontSize="10" Foreground="{ThemeResource HalvoTextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Milestone 3 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                <Border Height="80" Width="14" CornerRadius="6" Background="{ThemeResource HalvoEmeraldBrush}"/>
                                <TextBlock Text="Ep 15" FontSize="10" Foreground="{ThemeResource HalvoTextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Milestone 4 -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                <Border Height="95" Width="14" CornerRadius="6" Background="{ThemeResource HalvoEmeraldBrush}"/>
                                <TextBlock Text="Ep 20" FontSize="10" Foreground="{ThemeResource HalvoTextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Milestone 5 -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                <Border Height="110" Width="14" CornerRadius="6" Background="{ThemeResource HalvoEmeraldBrush}"/>
                                <TextBlock Text="Ep 25" FontSize="10" Foreground="{ThemeResource HalvoTextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Epoch History Logs -->
                <Border Grid.Row="3" Background="{ThemeResource HalvoHeaderGlassBrush}" Padding="12" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource HalvoCardBorderBrush}">
                    <ListView x:Name="EpochLogsList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Code, Segoe UI" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}" Margin="4,2"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
