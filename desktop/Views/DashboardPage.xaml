                                <TextBlock Grid.Column="2" Text="32%" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource HalvoBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- TypeScript / JS -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TypeScript / Web" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Value="14" Maximum="100" Height="10" CornerRadius="5" Foreground="{ThemeResource HalvoAmberBrush}"/>
                                <TextBlock Grid.Column="2" Text="14%" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource HalvoAmberBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Others -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dart / C++ / Rust" FontSize="11" Foreground="{ThemeResource HalvoTextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Value="6" Maximum="100" Height="10" CornerRadius="5" Foreground="{ThemeResource HalvoCyanBrush}"/>
                                <TextBlock Grid.Column="2" Text="6%" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource HalvoCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
