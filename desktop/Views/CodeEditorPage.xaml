<Page
    x:Class="CodeVision.Desktop.Views.CodeEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">

    <Grid Padding="20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Files Navigation -->
        <Border Background="{ThemeResource CyberCardGlassBrush}" Padding="14" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📂 ملفات المشروع المستعادة" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource CyberPrimaryBrush}"/>

                <ListView x:Name="FilesListView" Grid.Row="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" Margin="0,2" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource CyberPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TargetFilePath}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Name="AddFileBtn" Grid.Row="2" Content="➕ إضافة ملف جديد" HorizontalAlignment="Stretch" CornerRadius="8" Click="AddFileBtn_Click"/>
            </Grid>
        </Border>

        <!-- Right Code Editor Workspace -->
        <Border Grid.Column="1" Background="{ThemeResource CyberCardGlassBrush}" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Editor Toolbar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="لغة البرمجة:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="160"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveBtn" Content="💾 حفظ التعديل" Background="{ThemeResource CyberProgressBarBrush}" Foreground="White" CornerRadius="8" Click="SaveBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Code Editor Area -->
                <Border Grid.Row="1" Background="#0A0F1D" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#1E293B">
                    <TextBox x:Name="EditorBox" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Cascadia Code" FontSize="14" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0"/>
                </Border>

                <!-- Bottom Status -->
                <TextBlock x:Name="EditorStatusLabel" Grid.Row="2" Text="المحرر جاهز." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Page>
