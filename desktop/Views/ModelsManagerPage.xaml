<Page
    x:Class="CodeVision.Desktop.Views.ModelsManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FlowDirection="RightToLeft">

    <Grid Padding="20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Models List -->
        <Border Background="{ThemeResource CyberCardGlassBrush}" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📦 النماذج المتاحة والمثبتة" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource CyberPrimaryBrush}"/>

                <ListView x:Name="ModelsListView" Grid.Row="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CyberCardGlassBrush}" Padding="10" Margin="0,4" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Architecture}" Opacity="0.7" FontSize="11"/>
                                    <TextBlock Text="{Binding CreatedDate}" Opacity="0.5" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Name="SetActiveBtn" Grid.Row="2" Content="⭐ تعيين كنموذج نشط في Runtime" Background="{ThemeResource CyberProgressBarBrush}" Foreground="White" CornerRadius="8" HorizontalAlignment="Stretch" Click="SetActiveBtn_Click"/>
            </Grid>
        </Border>

        <!-- Right Model Details & Metrics -->
        <Border Grid.Column="1" Background="{ThemeResource CyberCardGlassBrush}" Padding="20" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ModelTitleLabel" Text="تفاصيل وتقييم النموذج" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource CyberSecondaryBrush}"/>

                <!-- Metrics Grid -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource CyberCardGlassBrush}" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="الدقة (Accuracy)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="AccLabel" Text="92.5%" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource CyberCardGlassBrush}" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="الإحكام (Precision)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="PrecLabel" Text="91.0%" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource CyberSuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{ThemeResource CyberCardGlassBrush}" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="الاسترجاع (Recall)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="RecallLabel" Text="89.5%" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource CyberWarningBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{ThemeResource CyberCardGlassBrush}" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="F1-Score" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock x:Name="F1Label" Text="90.2%" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource CyberSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock x:Name="WeightsPathLabel" Text="مسار الأوزان: builtin" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ActiveStatusLabel" Text="الحالة: نموذج افتراضي نشط" Foreground="{ThemeResource CyberSuccessBrush}" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock x:Name="ModelsStatusLabel" Grid.Row="3" Text="إدارة النماذج جاهزة." VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
