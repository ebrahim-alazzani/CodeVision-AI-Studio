<ContentDialog
    x:Class="CodeVision.Desktop.Views.DiagnosticsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="🔍 CodeVision Diagnostics &amp; Live Logs"
    PrimaryButtonText="Close"
    DefaultButton="Primary"
    CornerRadius="12"
    MinWidth="680"
    MinHeight="460">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Padding="4">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Real-time Python Engine, OCR, &amp; Multimodal Transcription Tracer" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="🔄 Refresh Logs" Click="Refresh_Click" Height="32"/>
                <Button Content="📋 Copy Log File Path" Click="CopyPath_Click" Height="32"/>
                <Button Content="🧹 Clear Screen" Click="Clear_Click" Height="32"/>
            </StackPanel>
        </StackPanel>

        <!-- Log Content Box -->
        <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#1E293B">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Foreground="#38BDF8" Background="Transparent" BorderThickness="0"/>
            </ScrollViewer>
        </Border>

        <!-- Log File Location Label -->
        <TextBlock Grid.Row="2" x:Name="LogPathText" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Grid>
</ContentDialog>
