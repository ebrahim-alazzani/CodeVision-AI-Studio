<Page
    x:Class="CodeVision.Desktop.Views.ProjectReconstructionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CodeVision.Desktop.Models"
    xmlns:viewmodels="using:CodeVision.Desktop.ViewModels"
    FlowDirection="RightToLeft">

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Source Job Bar -->
        <Border Background="{ThemeResource CyberCardGlassBrush}" Padding="16,12" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                    <StackPanel>
                        <TextBlock Text="إعادة بناء وتصدير المشروع المتكامل" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                        <TextBlock Text="استعادة كود المشاريع وهيكليتها المعمارية عبر الذكاء الاصطناعي وSequenceMatcher" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Job Selector Dropdown -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="مصدر الاستخراج:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                    <ComboBox x:Name="JobSelector" MinWidth="340" SelectionChanged="JobSelector_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:AvailableJobItem">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="RefreshJobsBtn" Content="🔄 تحديث" CornerRadius="6" Click="RefreshJobsBtn_Click"/>
                </StackPanel>

                <!-- Project Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#1A00E5FF" Padding="10,6" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CyberPrimaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="الملفات:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TotalFilesLabel" Text="0" FontWeight="Bold" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A00E676" Padding="10,6" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CyberSuccessBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="الأسطر:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TotalLinesLabel" Text="0" FontWeight="Bold" Foreground="{ThemeResource CyberSuccessBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3-Column Core Workspace -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <!-- Col 0: File Tree & Export (310px) -->
                <ColumnDefinition Width="310"/>
                <!-- Col 1: Chronological Snapshots Flow (360px) -->
                <ColumnDefinition Width="360"/>
                <!-- Col 2: Code Viewer & Editor (*) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Project Tree Structure -->
            <Border Background="{ThemeResource CyberCardGlassBrush}" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D2;" FontSize="15" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                        <TextBlock Text="🌳 شجرة مجلدات وملفات المشروع" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                    </StackPanel>

                    <!-- TreeView with standard non-compiled Binding to avoid Xaml casting exception -->
                    <Border Grid.Row="1" Background="#0AFFFFFF" CornerRadius="8" Padding="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <TreeView x:Name="ProjectTreeView" ItemInvoked="ProjectTreeView_ItemInvoked">
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource CyberWarningBrush}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <!-- Export Actions Box -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBox x:Name="ProjectNameBox" Header="اسم المشروع المستعاد" PlaceholderText="ViceCityUnityGame"/>
                        <Button x:Name="ExportProjectBtn" Content="🚀 تصدير المشروع الكامل (.sln / .csproj)" 
                                Background="{ThemeResource CyberProgressBarBrush}" Foreground="White" FontWeight="Bold"
                                CornerRadius="8" HorizontalAlignment="Stretch" Click="ExportProjectBtn_Click"/>
                        <Button x:Name="OpenExportFolderBtn" Content="📂 فتح مجلد المشروع المصدّر" 
                                Background="#1A00E676" BorderBrush="{ThemeResource CyberSuccessBrush}" BorderThickness="1"
                                Foreground="{ThemeResource CyberSuccessBrush}" CornerRadius="8" HorizontalAlignment="Stretch"
                                Visibility="Collapsed" Click="OpenExportFolderBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column 1: Chronological Reconstruction Flow -->
            <Border Grid.Column="1" Background="{ThemeResource CyberCardGlassBrush}" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE823;" FontSize="15" Foreground="{ThemeResource CyberSecondaryBrush}"/>
                        <TextBlock Text="⏱ الترتيب الزمني للأدلة والمقاطع المستعادة" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource CyberSecondaryBrush}"/>
                    </StackPanel>

                    <ListView x:Name="OrderedSnippetsList" Grid.Row="1" SelectionChanged="OrderedSnippetsList_SelectionChanged" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ExtractedCodeSnippet">
                                <Border Background="{ThemeResource CyberCardGlassBrush}" Padding="10" Margin="0,4" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Timestamp Badge -->
                                        <Border Background="#1A00E5FF" Padding="6,2" CornerRadius="5" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{ThemeResource CyberPrimaryBrush}">
                                            <TextBlock Text="{x:Bind TimestampFormatted}" Foreground="{ThemeResource CyberPrimaryBrush}" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Target File Path -->
                                        <TextBlock Grid.Column="1" Text="{x:Bind TargetFilePath}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- Confidence Badge -->
                                        <Border Grid.Column="2" Background="#1A00E676" Padding="6,2" CornerRadius="5" BorderThickness="1" BorderBrush="{ThemeResource CyberSuccessBrush}">
                                            <TextBlock Text="{x:Bind ConfidencePercent}" Foreground="{ThemeResource CyberSuccessBrush}" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Code Preview Line -->
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind CodeContent}" MaxLines="2" TextTrimming="CharacterEllipsis" Opacity="0.75" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Column 2: Code Viewer & Editor -->
            <Border Grid.Column="2" Background="{ThemeResource CyberCardGlassBrush}" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Code Viewer Top Bar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE943;" FontSize="15" Foreground="{ThemeResource CyberSuccessBrush}"/>
                            <TextBlock x:Name="SelectedFileNameLabel" Text="ShootingController.cs" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource CyberSuccessBrush}"/>
                            <TextBlock x:Name="SelectedFileMetaLabel" Text="C# · ثقة: 98%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CopyCodeBtn" Content="📋 نسخ الشيفرة" CornerRadius="6" Click="CopyCodeBtn_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Code Text Editor / Viewer -->
                    <Border Grid.Row="1" Background="#0F0F14" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="CodeDisplayBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12.5"
                                     Background="Transparent" BorderThickness="0" Foreground="#E0E6ED"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Export Status Bar -->
        <Border Grid.Row="2" Background="{ThemeResource CyberCardGlassBrush}" Padding="14,10" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="ExportStatusLabel" Text="جاهز لتصدير المشروع المستعاد." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Border>
    </Grid>
</Page>
