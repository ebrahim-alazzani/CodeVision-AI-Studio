<Window
    x:Class="CodeVision.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CodeVision Studio · AI Code Reconstruction (Cyber Edition)">

    <Grid>
        <!-- CodeVision Cyber AI Wallpaper Background (Dedicated Dark & Light Assets) -->
        <Image x:Name="HalvoBackgroundImage"
               Source="ms-appx:///Assets/codevision_cyber_bg_dark.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <!-- Specular Ambient Tint & Blur Overlay -->
        <Rectangle x:Name="HalvoOverlay"
                   Fill="{ThemeResource HalvoOverlayBrush}"/>

        <!-- Main Window Content Grid -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom App Title Bar Header -->
                <RowDefinition Height="Auto" />
                <!-- App Main Body -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom App TitleBar with Integrated Minimize/Maximize/Close Area -->
            <Border Grid.Row="0"
                    Height="48"
                    Background="{ThemeResource HalvoHeaderGlassBrush}"
                    BorderBrush="{ThemeResource HalvoCardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0,0,0">
                <Grid x:Name="AppTitleBar">
                    <Grid.ColumnDefinitions>
                        <!-- Brand Logo & Title -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Quick Action Button -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Center Search -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right Quick Tools -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Reserved Window Caption Buttons Area (Min / Max / Close) -->
                        <ColumnDefinition Width="145"/>
                    </Grid.ColumnDefinitions>

                    <!-- Halvo Brand Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource HalvoGradientCyanBlue}">
                            <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="#0B0F15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CODEVISION STUDIO" FontWeight="Black" FontSize="13" CharacterSpacing="60" Foreground="{ThemeResource HalvoTextPrimaryBrush}"/>
                            <TextBlock Text="AI CODE RECONSTRUCTION" FontSize="8" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{ThemeResource HalvoCyanBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick Action: New Extraction (Single or Batch) -->
                    <Button x:Name="BtnNewExtraction"
                            Grid.Column="1"
                            Margin="20,0,0,0"
                            Padding="14,6,16,6"
                            CornerRadius="8"
                            Background="{ThemeResource HalvoGradientCyanBlue}"
                            Foreground="#0B0F15"
                            Click="BtnNewExtraction_Click"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="#0B0F15"/>
                            <TextBlock Text="استخراج جديد (فردي / حزم)" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <!-- Center Search Bar -->
                    <AutoSuggestBox x:Name="SearchBox"
                                    Grid.Column="2"
                                    PlaceholderText="بحث في الفيديوهات، الشيفرات، المقاطع والمشاريع…"
                                    Width="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    QueryIcon="Find"/>

                    <!-- Right Quick Actions -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Click="BtnLiveLogs_Click"
                                ToolTipService.ToolTip="سجل النظام والتشخيص الحي (Live Logs)"
                                CornerRadius="8"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{ThemeResource HalvoCyanBrush}"/>
                                <TextBlock Text="Live Logs" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ThemeToggleBtn"
                                Content="◐"
                                FontSize="13"
                                Width="36"
                                Height="32"
                                CornerRadius="8"
                                ToolTipService.ToolTip="تبديل المظهر (Dark / Light Theme)"
                                Click="ThemeToggleBtn_Click"/>
                    </StackPanel>

                    <!-- Column 4 (Width 145) is automatically occupied by the OS Caption Buttons seamlessly -->
                </Grid>
            </Border>

            <!-- Main Navigation Shell -->
            <NavigationView x:Name="NavView"
                            Grid.Row="1"
                            SelectionChanged="NavView_SelectionChanged"
                            IsSettingsVisible="True"
                            PaneTitle="CodeVision Menu"
                            PaneDisplayMode="Left"
                            OpenPaneLength="245"
                            CompactPaneLength="52"
                            Background="Transparent">

                <NavigationView.MenuItems>
                    <NavigationViewItem Content="لوحة التحكم (Dashboard)" Tag="dashboard">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" Foreground="{ThemeResource HalvoCyanBrush}"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="المكتبة وحزم الفيديوهات" Tag="library">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B9;" Foreground="{ThemeResource HalvoBlueBrush}"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="استوديو المحاكاة والمراجعة" Tag="review">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE768;" Foreground="{ThemeResource HalvoPurpleBrush}"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="محرر الشيفرة والملفات" Tag="editor">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE943;" Foreground="{ThemeResource HalvoEmeraldBrush}"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="إعادة بناء المشروع وتصديره" Tag="reconstruct">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource HalvoAmberBrush}"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItemSeparator/>

                    <NavigationViewItem Content="مختبر التدريب (Training Lab)" Tag="training">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE9D9;" Foreground="{ThemeResource HalvoRoseBrush}"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem Content="إدارة النماذج والبيانات" Tag="models">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE774;" Foreground="{ThemeResource HalvoCyanBrush}"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <!-- Page Display Container -->
                <Frame x:Name="ContentFrame" Background="Transparent" Margin="6,6,6,6"/>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
